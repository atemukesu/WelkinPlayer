<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ (targetSdk 28+) blocks cleartext HTTP by default, which also
  applies to release builds of this app. The frontend streams audio from the
  Rust loopback proxy over http://127.0.0.1:<random port>/stream, so cleartext
  has to be allowed for loopback (and the emulator host alias) only.

  Note: android:usesCleartextTraffic in AndroidManifest.xml is ignored on
  Android 7.0+ as soon as this config is present, so keep the two in sync.

  If you use WebDAV over plain HTTP on your LAN, add that host/IP as another
  <domain> here.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <!-- Android emulator alias for the host machine. -->
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
