post_install() {
  # pacman restores the setuid bit from .MTREE, but it silently fails on
  # filesystems mounted nosuid (e.g. a separately mounted /usr).
  local sb=/usr/share/Welkin/chrome-sandbox
  if [[ -e $sb && ! -u $sb ]]; then
    chmod 4755 "$sb"
  fi

  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q 2>/dev/null || true
}

post_upgrade() {
  post_install
}

post_remove() {
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q 2>/dev/null || true
}
