<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds keep Tauri's previous behaviour of allowing all cleartext HTTP
  (the manifest's android:usesCleartextTraffic="true" for the debug build type),
  so LAN WebDAV over plain HTTP keeps working while developing.

  This file overrides src/main/res/xml/network_security_config.xml for the
  debug variant only; release builds use the restrictive loopback-only config.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
